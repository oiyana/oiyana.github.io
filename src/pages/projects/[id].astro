---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectTitle from '../../components/ProjectTitle.astro';
import GridLayout from '../../layouts/GridLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project }
    }));
}

type Props = {
    project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const { title, headline, description, seo } = project.data;
const { Content } = await render(project);
---

<GridLayout
    title={seo?.title ?? title}
    description={seo?.description ?? description}
    image={seo?.image}
    pageType="article"
    sectionLabel="WORK"
    sectionHref="/projects/"
>
    <article class="mt-12 mb-16 sm:mb-24 md:mt-16">
        <header class="mb-8 sm:mb-10">
            {
                headline ? (
                    <>
                        <ProjectTitle
                            title={title}
                            headingLevel="p"
                            weight="normal"
                            fontFamily="roboto-mono"
                            class="mb-3 text-[14px] uppercase"
                        />
                        <h1 class="font-sans text-3xl leading-tight font-bold">{headline}</h1>
                    </>
                ) : (
                    <ProjectTitle title={title} headingLevel="h1" class="text-3xl" />
                )
            }
        </header>
        <div class="prose project-prose max-w-none">
            <Content />
        </div>
    </article>
    <dialog class="project-image-viewer" data-project-image-viewer aria-label="Full-size project image">
        <button type="button" class="project-image-viewer__close" data-project-image-close>Close</button>
        <img data-project-image-full alt="" />
    </dialog>
</GridLayout>

<script>
    const initializeProjectImageViewer = () => {
        const dialog = document.querySelector<HTMLDialogElement>('[data-project-image-viewer]');
        if (!dialog || dialog.dataset.initialized) return;

        const fullImage = dialog.querySelector<HTMLImageElement>('[data-project-image-full]');
        const closeButton = dialog.querySelector<HTMLButtonElement>('[data-project-image-close]');
        if (!fullImage || !closeButton) return;

        dialog.dataset.initialized = 'true';

        document.querySelectorAll<HTMLImageElement>('.project-prose img').forEach((image) => {
            if (image.dataset.viewerInitialized) return;

            image.dataset.viewerInitialized = 'true';
            image.tabIndex = 0;
            image.setAttribute('role', 'button');
            image.setAttribute('aria-label', `View full-size image: ${image.alt || 'Project image'}`);

            const openImage = () => {
                fullImage.src = image.currentSrc || image.src;
                fullImage.alt = image.alt;
                dialog.showModal();
            };

            image.addEventListener('click', openImage);
            image.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    openImage();
                }
            });
        });

        closeButton.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog || event.target === fullImage) dialog.close();
        });
    };

    initializeProjectImageViewer();
    document.addEventListener('astro:page-load', initializeProjectImageViewer);
</script>
