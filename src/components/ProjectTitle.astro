---
import { Icon } from 'astro-icon/components';
import mediumLogoUrl from '../assets/images/medium.svg?url';

type Props = {
    title: string;
    headingLevel?: 'h1' | 'h2' | 'h3' | 'p';
    weight?: 'normal' | 'bold';
    fontFamily?: 'sans' | 'mono' | 'roboto-mono';
    iconOnly?: boolean;
    class?: string;
};

const { title, headingLevel = 'h2', weight = 'bold', fontFamily = 'sans', iconOnly = false, class: className } = Astro.props;
const TitleTag = headingLevel;
const brands: { name: string; icon?: string; image?: string }[] = [
    { name: 'NYT Games', icon: 'simple-icons:newyorktimes' },
    { name: 'Medium', image: mediumLogoUrl },
    { name: 'BuzzFeed', icon: 'simple-icons:buzzfeed' }
];
const brand = brands.find(({ name }) => title.includes(name));
const brandIndex = brand ? title.indexOf(brand.name) : -1;
const beforeBrand = brandIndex >= 0 ? title.slice(0, brandIndex) : '';
const afterBrand = brand && brandIndex >= 0 ? title.slice(brandIndex + brand.name.length) : '';
---

<TitleTag
    class:list={[
        fontFamily === 'roboto-mono' ? 'font-roboto-mono' : fontFamily === 'mono' ? 'font-mono' : 'font-sans',
        'leading-tight',
        weight === 'bold' ? 'font-bold' : 'font-normal',
        className
    ]}
>
    {
        brand && iconOnly ? (
            <>
                {brand.image ? (
                    <img src={brand.image} alt="" class="inline-block h-[1.25em] w-auto dark:invert" aria-hidden="true" />
                ) : (
                    <Icon name={brand.icon!} class="inline-block h-[1.25em] w-[1.25em]" aria-hidden="true" />
                )}
                <span class="sr-only">{title}</span>
            </>
        ) : brand ? (
            <>
                {beforeBrand}
                {brand.image ? (
                    <img src={brand.image} alt="" class="mr-[0.2em] inline-block h-[0.8em] w-auto align-[-0.08em] dark:invert" aria-hidden="true" />
                ) : (
                    <Icon name={brand.icon!} class="mr-[0.2em] inline-block h-[0.8em] w-[0.8em] align-[-0.08em]" aria-hidden="true" />
                )}
                {brand.name}
                {afterBrand}
            </>
        ) : (
            title
        )
    }
</TitleTag>