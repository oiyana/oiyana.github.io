---
import type { Hero as HeroProps } from '../types';
import Button from './Button.astro';
import CustomImage from './CustomImage.astro';

type Props = HeroProps;

const { title, titleImage, subtitle, image, actions } = Astro.props;
---

<section class="mb-16 flex w-full flex-col gap-8 sm:mb-24">
    {
        titleImage?.src ? (
            <h1 class="logo-blue h-24 max-md:pt-4 pt-6 sm:h-[6.75rem] [&>img]:h-full [&>img]:w-auto [&>img]:object-contain">
                <CustomImage
                    src={titleImage.src}
                    alt={titleImage.alt ?? ''}
                    class="logo-blue__img h-full w-auto object-contain"
                    loading="eager"
                    fetchpriority="high"
                />
            </h1>
        ) : title ? (
            <h1 class="font-sans text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        ) : null
    }
    {subtitle && <p class="flex items-center gap-3 text-theme-foreground">{subtitle}</p>}
    {
        image?.src && (
            <figure>
                <CustomImage
                    class="w-full"
                    {...image}
                    widths={[480, 640, 768, 1024, 1536]}
                    sizes="(min-width: 832px) 768px, calc(100vw - 32px)"
                    fetchpriority="high"
                    loading="eager"
                />
                {image.caption && <figcaption class="mt-1.5 text-xs sm:text-sm padding-top: 0.35em">{image.caption}</figcaption>}
            </figure>
        )
    }

    <div class="prose prose-lg max-w-none prose-hero">
        <p>
            I’m Jac. I build products, create systems, and lead teams to solve problems worth solving, driving growth,
            and delivering lasting impact.
        </p>

        <p>
            Currently, I lead{' '}
            <button
                type="button"
                class="builder-toggle wave-underline"
                aria-expanded="false"
                aria-controls="expand-subscriber-engagement"
                data-builder-toggle
                data-expand-image="expand-subscriber-engagement-image"
            >
                <span class="builder-toggle__label">subscriber engagement and growth</span>
                <span class="builder-toggle__icon" aria-hidden="true" data-builder-icon>+</span>
            </button>{' '}
            at the{' '}
            <a href="https://www.nytimes.com/crosswords/apps" class="company-link">The New York Times Games</a>, building
            experiences that delights for millions of players every day.{' '}
            <span id="expand-subscriber-engagement" class="builder-expand" data-builder-expanded hidden>
                I expanded my team’s scope from individual features to the core experience across a portfolio of live games, 
                including 0-to-1 launches, growth optimizations, and horizontal expansion. Together, we build the core loop 
                that maximizes the engagement lifecycle through badges, stats, streaks, and a live ops program. 
                We also tripled premium features for subscribers, creating more value for paid users.
            </span>
        </p>
        <figure id="expand-subscriber-engagement-image" class="builder-expand__figure" hidden>
            <img
                class="builder-expand__image"
                src="/image-nyt/nyt-games-badges-2.gif"
                alt="New York Times Games achievement badges"
                loading="lazy"
            />
            <figcaption class="builder-expand__caption">Badge Systems (2025). Built with Robert Vinluan, Michael Ingber, Steven Speicher.</figcaption>
        </figure>

        <p>
            Previously at{' '}
            <a href="https://medium.com/" class="company-link">Medium</a>, I helped hundreds of thousands of{' '}
            <button
                type="button"
                class="builder-toggle wave-underline"
                aria-expanded="false"
                aria-controls="expand-creators"
                data-builder-toggle
                data-expand-image="expand-creators-image"
            >
                <span class="builder-toggle__label">creators</span>
                <span class="builder-toggle__icon" aria-hidden="true" data-builder-icon>+</span>
            </button>{' '}
            from independent writers to public figures, grow their audiences and earnings.{' '}
            <span id="expand-creators" class="builder-expand" data-builder-expanded hidden>
                The goal was to give writers more control and transparency, and to build trust in the platform.
            </span>
        </p>
        <figure id="expand-creators-image" class="builder-expand__figure" hidden>
            <img
                class="builder-expand__image"
                src="/image-medium/medium-email-hero.png"
                alt="Medium email feature"
                loading="lazy"
            />
            <figcaption class="builder-expand__caption">Writer Subscription (2021). Built with Abby Aker.</figcaption>
        </figure>

        <p>
            At{' '}
            <a href="https://www.buzzfeed.com/" class="company-link">BuzzFeed</a>, known for creating viral moments, I held{' '}
            <button
                type="button"
                class="builder-toggle wave-underline"
                aria-expanded="false"
                aria-controls="expand-two-roles"
                data-builder-toggle
                data-expand-image="expand-two-roles-image"
            >
                <span class="builder-toggle__label">two roles</span>
                <span class="builder-toggle__icon" aria-hidden="true" data-builder-icon>+</span>
            </button>{' '}
            driving their meteoric audience growth.{' '}
            <span id="expand-two-roles" class="builder-expand" data-builder-expanded hidden>
                As a product designer, I created game mechanics engineered for virality, 
                then built dashboards to track traffic and trends, identifying what worked and what to replicate. 
                I later moved into product management, where I scaled a content publishing workflow powered by 
                automation and ML recommendations, reaching over 9 billion content views a month.
            </span>
        </p>
        <figure id="expand-two-roles-image" class="builder-expand__figure" hidden>
            <img
                class="builder-expand__image"
                src="/image-buzzfeed/buzzfeed-recommendation-hero.png"
                alt="BuzzFeed recommendation feature"
                loading="lazy"
            />
            <figcaption class="builder-expand__caption">Internal Publishing Tool (2019). Built with Andrea Handevidt, Alex Gervais and Kevin Merritt.</figcaption>
        </figure>

        <p>
            From serving millions of players every day to helping small teams scale their output, I enjoy operating at
            the intersection of value creation, intentional design, and measurable impact. To get there, I bring the
            right people together, create the conditions for great work, and build systems that outlast any single
            project, all while having fun along the way.
        </p>

        <p>
            Outside my role, I also do advisory, mentoring, and connecting others over running. You can reach me via{' '}
            <button
                type="button"
                class="email-copy"
                data-email-copy
                data-email="jac.oiyana@gmail.com"
                aria-label="Copy email address"
            >
                <span data-email-label>email</span>
                <svg class="contact-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <rect
                        x="5.5"
                        y="5.5"
                        width="8"
                        height="8"
                        rx="1.25"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"></rect>
                    <path
                        d="M10.5 5.5V3.75A1.25 1.25 0 0 0 9.25 2.5H3.75A1.25 1.25 0 0 0 2.5 3.75v5.5A1.25 1.25 0 0 0 3.75 10.5H5.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"></path>
                </svg>
            </button>{' '}
            or find me on{' '}
            <a href="https://www.linkedin.com/in/jacquelineyue/" class="linkedin-link" data-linkedin-link>
                LinkedIn
                <svg class="contact-icon linkedin-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path
                        d="M3 8h8.2M8.2 4.2 12 8l-3.8 3.8"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </a>.
        </p>
    </div>

    {
        actions && actions.length > 0 && (
            <div class="flex flex-wrap gap-4">
                {actions.map((action) => (
                    <Button href={action.href}>{action.text}</Button>
                ))}
            </div>
        )
    }
</section>

<style>
    .logo-blue :global(img),
    .logo-blue__img {
        filter: invert(18%) sepia(95%) saturate(4500%) hue-rotate(214deg) brightness(95%) contrast(101%);
    }

    :global(html.dark) .logo-blue :global(img),
    :global(html.dark) .logo-blue__img {
        filter: invert(42%) sepia(98%) saturate(2146%) hue-rotate(214deg) brightness(103%) contrast(101%);
    }

    .builder-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.15em;
        margin: 0 0.1em;
        padding: 0.25em 0.15em 0.28em;
        vertical-align: baseline;
        border: none;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-weight: 600;
        line-height: 1.4;
        cursor: pointer;
        box-shadow: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .builder-toggle:hover,
    .builder-toggle[aria-expanded='true'],
    .builder-toggle[aria-expanded='true']:hover,
    .email-copy:hover,
    :global(.prose a.linkedin-link:hover) {
        background: color-mix(in srgb, var(--text-main) 6%, transparent);
    }

    .builder-toggle:focus-visible,
    .email-copy:focus-visible {
        outline: 2px solid #0348de;
        outline-offset: 2px;
    }

    :global(html.dark) .builder-toggle:focus-visible,
    :global(html.dark) .email-copy:focus-visible {
        outline-color: #4574ff;
    }

    .builder-toggle[aria-expanded='true'] {
        color: #0348de;
    }

    :global(html.dark) .builder-toggle[aria-expanded='true'] {
        color: #4574ff;
    }

    .builder-toggle__icon {
        color: #0348de;
        font-weight: 800;
        font-size: 0.95em;
        line-height: 1;
        min-width: 0.65em;
        text-align: center;
    }

    :global(html.dark) .builder-toggle__icon {
        color: #4574ff;
    }

    .builder-expand {
        font-style: normal;
        font-weight: 400;
    }

    .builder-expand[hidden],
    .builder-expand__figure[hidden] {
        display: none;
    }

    .builder-expand__figure {
        margin: 0.75em 0 1.25em;
        padding: 0;
    }

    .builder-expand__image {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        margin: 0;
    }

    .builder-expand__caption {
        margin-top: 0.65em;
        font-size: 13px;
        line-height: 1.4;
        font-weight: 400;
        text-align: left;
        color: #171717;
    }

    :global(html.dark) .builder-expand__caption {
        color: #ffffff;
    }

    :global(.prose a.company-link) {
        font-weight: 600;
        text-decoration: none;
    }

    :global(.prose a.company-link:hover) {
        text-decoration: none;
    }

    .email-copy {
        display: inline-flex;
        align-items: baseline;
        gap: 0.22em;
        width: auto;
        padding: 0.25em 0.15em 0.28em;
        border: none;
        background: none;
        color: inherit;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        vertical-align: baseline;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    :global(.prose a.linkedin-link) {
        display: inline-flex;
        align-items: baseline;
        gap: 0.22em;
        width: auto;
        padding: 0.25em 0.15em 0.28em;
        text-decoration: none;
        white-space: nowrap;
        vertical-align: baseline;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .contact-icon {
        display: inline-block;
        width: 0.8em;
        height: 0.8em;
        flex: 0 0 0.8em;
        color: #0348de;
        overflow: visible;
        transform: translateY(0.1em);
    }

    :global(html.dark) .contact-icon {
        color: #4574ff;
    }

    .linkedin-arrow.is-nudging {
        animation: linkedin-nudge 0.28s ease-in-out 3;
    }

    @keyframes linkedin-nudge {
        0%,
        100% {
            transform: translate(0, 0.1em);
        }
        50% {
            transform: translate(0.22em, 0.1em);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .linkedin-arrow.is-nudging {
            animation: none;
        }
    }
</style>

<script>
    function initBuilderToggles() {
        document.querySelectorAll<HTMLButtonElement>('[data-builder-toggle]').forEach((button) => {
            if (button.dataset.bound === 'true') return;
            button.dataset.bound = 'true';

            const expandId = button.getAttribute('aria-controls');
            const expanded = expandId ? document.getElementById(expandId) : null;
            const imageId = button.getAttribute('data-expand-image');
            const expandImage = imageId ? document.getElementById(imageId) : null;
            const icon = button.querySelector<HTMLElement>('[data-builder-icon]');
            if (!expanded || !icon) return;

            button.addEventListener('click', () => {
                const isOpen = button.getAttribute('aria-expanded') === 'true';
                const nextOpen = !isOpen;

                button.setAttribute('aria-expanded', String(nextOpen));
                icon.textContent = nextOpen ? '×' : '+';
                expanded.hidden = !nextOpen;
                if (expandImage) expandImage.hidden = !nextOpen;
            });
        });
    }

    function initWaveUnderlines() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        document.querySelectorAll<HTMLElement>('.wave-underline').forEach((el) => {
            if (el.dataset.waveBound === 'true') return;
            el.dataset.waveBound = 'true';

            const scheduleNextWave = () => {
                const wait = 7000 + Math.random() * 16000;
                window.setTimeout(() => {
                    el.classList.add('is-waving');
                    window.setTimeout(() => {
                        el.classList.remove('is-waving');
                        scheduleNextWave();
                    }, 2200 + Math.random() * 1200);
                }, wait);
            };

            window.setTimeout(scheduleNextWave, Math.random() * 4000);
        });
    }

    function initEmailCopy() {
        document.querySelectorAll<HTMLButtonElement>('[data-email-copy]').forEach((button) => {
            if (button.dataset.bound === 'true') return;
            button.dataset.bound = 'true';

            const label = button.querySelector<HTMLElement>('[data-email-label]');
            if (!label) return;

            button.addEventListener('click', async () => {
                const email = button.getAttribute('data-email') || '';

                try {
                    await navigator.clipboard.writeText(email);
                } catch {
                    return;
                }

                const previousTimeout = Number(button.dataset.copiedTimeout || 0);
                if (previousTimeout) window.clearTimeout(previousTimeout);

                label.textContent = 'copied to clipboard';
                button.setAttribute('aria-label', 'Email address copied');

                button.dataset.copiedTimeout = String(
                    window.setTimeout(() => {
                        label.textContent = 'email';
                        button.setAttribute('aria-label', 'Copy email address');
                        delete button.dataset.copiedTimeout;
                    }, 3000)
                );
            });
        });
    }

    function nudgeLinkedInArrow(arrow: HTMLElement) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        arrow.classList.remove('is-nudging');
        // Restart animation if already running
        void arrow.offsetWidth;
        arrow.classList.add('is-nudging');
        arrow.addEventListener(
            'animationend',
            () => {
                arrow.classList.remove('is-nudging');
            },
            { once: true }
        );
    }

    function initLinkedInArrow() {
        document.querySelectorAll<HTMLAnchorElement>('[data-linkedin-link]').forEach((link) => {
            if (link.dataset.bound === 'true') return;
            link.dataset.bound = 'true';

            const arrow = link.querySelector<HTMLElement>('.linkedin-arrow');
            if (!arrow) return;

            link.addEventListener('mouseenter', () => nudgeLinkedInArrow(arrow));
            link.addEventListener('click', () => nudgeLinkedInArrow(arrow));
        });
    }

    initBuilderToggles();
    initWaveUnderlines();
    initEmailCopy();
    initLinkedInArrow();
    document.addEventListener('astro:page-load', () => {
        initBuilderToggles();
        initWaveUnderlines();
        initEmailCopy();
        initLinkedInArrow();
    });
</script>
